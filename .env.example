# Public browser key for Google Maps Embed API.
# Restrict it in Google Cloud to Maps Embed API and your production domains.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Google Analytics 4 measurement ID. The current production property is used
# as a safe fallback, but keeping the value here makes deployments explicit.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-0WT691QL9T
